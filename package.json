{
  "name": "safar-bus-tracking",
  "version": "1.0.0",
  "description": "Live bus tracking system for conductors and passengers",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "bus",
    "tracking",
    "transport",
    "real-time"
  ],
  "author": "Safar Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "firebase": "^12.2.1"
  }
}
